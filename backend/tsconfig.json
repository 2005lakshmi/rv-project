{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "skipLibCheck": true,
    "rootDir": "./src",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*", "server.js", "src/**/*.*"],
  "exclude": ["node_modules", "dist", "**/node_modules/*"]
}
